---
// Application for Searchable. Scrolls like the case studies (dots, prev/next,
// sideways-scrolling galleries) but every section is a full-screen slide that
// transitions in and out (scripts/slide-scroll.ts).
import Badge from "@components/Badge.astro";
import CaseStudiesScripts from "@components/CaseStudiesScripts.astro";
import CaseStudyHero from "@components/CaseStudyHero.astro";
import HologramHand from "@components/HologramHand.astro";
import HologramTelescope from "@components/HologramTelescope.astro";
import HorizontalGallery, { type GalleryItem } from "@components/HorizontalGallery.astro";
import Finale from "@components/Finale.astro";
import ClientLogos, { type Logo } from "@components/ClientLogos.astro";
import Slide from "@components/Slide.astro";
import ScreenshotStack, { type StackImage } from "@components/ScreenshotStack.astro";
import Layout from "@layouts/FullPage.astro";

const RESEARCH_URL = "https://labs.sitebulb.com/docs/checks/discoverability/robots-txt/";

const slides = [
  { id: "title", label: "Hi" },
  { id: "fit", label: "Why Searchable" },
  { id: "sitebulb", label: "At Sitebulb" },
  { id: "sitebulb-work", label: "Sitebulb work" },
  { id: "labs", label: "Sitebulb Labs" },
  { id: "extension", label: "The extension" },
  { id: "labs-work", label: "Inside the extension" },
  { id: "research", label: "Research" },
  { id: "now", label: "Why now" },
];

const sitebulbWork: GalleryItem[] = [
  {
    image: "/case-studies/product-tour/2.png",
    alt: "Storyboard for the Sitebulb product tour",
    caption: "Storyboarding a product tour that explains a crawler in under a minute.",
    gradient: "from-blue-500/40 to-red-900/10",
    href: "/case-studies/product-tour/",
  },
  {
    image: "/case-studies/open-crawl/6.jpg",
    alt: "Chart of where pages dropped out of a crawl",
    caption: "OpenCrawl: every URL in a crawl accounted for, from discovery to delivery.",
    gradient: "from-pink-500/40 to-purple-900/10",
    href: "/case-studies/open-crawl/",
  },
];

// Top of the stack first.
const sitebulbStack: StackImage[] = [
  { image: "/portals/wide/sitebulb.jpg", alt: "Sitebulb home page hero, layered over OpenCrawl screens", ratio: "16 / 9" },
  { image: "/case-studies/open-crawl/4.jpg", alt: "" },
  { image: "/case-studies/open-crawl/1.jpg", alt: "" },
];

// The sitebulb.com client logos: the best-known five everywhere, and the
// rest on wide screens where there's room.
const sitebulbClients: Logo[] = [
  ...[
    ["vogue", "Vogue"],
    ["deliveroo", "Deliveroo"],
    ["jaguar-land-rover", "Jaguar Land Rover"],
    ["lloyds-banking", "Lloyds Banking Group"],
    ["upwork", "Upwork"],
  ].map(([file, name]) => ({ file, name })),
  ...[
    ["7-eleven", "7-Eleven"],
    ["classpass", "ClassPass"],
    ["carfax", "Carfax"],
    ["costar", "CoStar"],
  ].map(([file, name]) => ({ file, name, largeOnly: true })),
].map(({ file, ...logo }) => ({ src: `/logos/sitebulb-customers/${file}.svg`, ...logo }));

const labsWork: GalleryItem[] = [
  {
    image: "/case-studies/labs/2.jpg",
    alt: "Extension side panel scanning the current page",
    caption: "The extension scores any page for AEO features as you browse.",
    gradient: "from-blue-500/40 to-red-900/10",
  },
  {
    image: "/case-studies/labs/about.jpg",
    alt: "Sitebulb Labs about page: Tools for a web that agents read",
    caption: "Labs ships small tools quickly and follows the standards while they're still moving.",
    gradient: "from-amber-500/40 to-red-900/10",
    href: "/case-studies/labs/",
    linkLabel: "Read the case study",
  },
];

const chevrons = {
  up: "M308.7 212.7C314.9 206.5 325.1 206.5 331.3 212.7L491.3 372.7C497.5 378.9 497.5 389.1 491.3 395.3C485.1 401.5 474.9 401.5 468.7 395.3L320 246.6L171.3 395.3C165.1 401.5 154.9 401.5 148.7 395.3C142.5 389.1 142.5 378.9 148.7 372.7L308.7 212.7z",
  down: "M308.7 427.3C314.9 433.5 325.1 433.5 331.3 427.3L491.3 267.3C497.5 261.1 497.5 250.9 491.3 244.7C485.1 238.5 474.9 238.5 468.7 244.7L320 393.4L171.3 244.7C165.1 238.5 154.9 238.5 148.7 244.7C142.5 250.9 142.5 261.1 148.7 267.3L308.7 427.3z",
};
---

<Layout
  title="Kevin Letchford for Searchable"
  description="Why I'd be a good fit for Searchable: design, engineering and search, and ten years of watching SEO change."
  noindex
>
  <div
    id="wrapper"
    class="h-dvh overflow-y-auto absolute inset-0 bg-gradient-to-r from-cyan-700/70 to-red-900/10"
  >
    <div
      class="section-nav bottom-2 fixed z-30 -translate-1/2 left-1/2 flex gap-4"
    >
      <button
        class="previous-section size-7 rounded-full flex items-center justify-center border-white/20 border bg-black/20 md:backdrop-blur-md text-white/70 cursor-pointer"
        aria-label="Previous slide"
      >
        <svg viewBox="0 0 640 640" fill="currentColor" aria-hidden="true" class="size-4 text-white/70">
          <path d={chevrons.up}></path>
        </svg>
      </button>
      <nav class="gap-4 items-center flex">
        {
          slides.map(({ id, label }, i) => (
            <a
              href={`#${id}`}
              data-nav-item={id}
              class:list={[
                "dot min-w-3 min-h-3 rounded-full bg-white/30 block",
                i === 0 && "dot_active",
              ]}
            >
              <span class="hidden">{label}</span>
            </a>
          ))
        }
      </nav>
      <button
        class="next-section size-7 rounded-full flex items-center justify-center border-white/20 border bg-black/20 md:backdrop-blur-md text-white/70 cursor-pointer"
        aria-label="Next slide"
      >
        <svg viewBox="0 0 640 640" fill="currentColor" aria-hidden="true" class="size-4 text-white/70">
          <path d={chevrons.down}></path>
        </svg>
      </button>
    </div>

    <div id="content">
      <article id="slides" class="w-full relative isolate">
        <HologramHand class="absolute inset-x-0 top-0 h-[100svh] -z-10" />
        <CaseStudyHero
          headline={"Hi Searchable,\nI'm Kevin"}
          subline="A design engineer who's spent over ten years in SEO. I'd love to help build what comes next in search, and this is why."
          readHref="#fit"
          readLabel="Show me why"
          skipHref="#now"
          skipLabel="Skip to say hello"
          class="pt-44"
        >
          <Badge slot="eyebrow" icon="wave">Wave</Badge>
        </CaseStudyHero>

        <Slide id="fit" title="Design, engineering and search">
          <p>
            I think I'd be a good fit for Searchable because of my interests in <Badge icon="search">design, engineering & search</Badge>.
          </p>
          <p>
            I really enjoy talking to people about the future of the web, and want to work with
            other people with the same passions and drives.
          </p>
          <HologramTelescope slot="aside" class="w-full max-w-[34rem] 2xl:max-w-[46rem] mx-auto aspect-square" />
        </Slide>

        <Slide id="sitebulb" title="Making technical data easy to act on">
          <p>
            I currently work at Sitebulb, where we build crawling software for
            SEOs, agencies and enterprise teams. A big part of my job is taking <Badge icon="chart">complicated technical data</Badge> and finding ways to make
            it easier to understand and act on.
          </p>
          <div slot="aside" class="min-w-0">
            <ScreenshotStack images={sitebulbStack} />
            <ClientLogos class="mt-10" logos={sitebulbClients} label="Used by 5,000+ SEOs at" />
          </div>
        </Slide>

        <HorizontalGallery id="sitebulb-work" items={sitebulbWork} />

        <Slide
          id="labs"
          title="Starting Sitebulb Labs"
          media={{
            image: "/case-studies/labs/1.jpg",
            alt: "Sitebulb Labs home page hero: Can AI agents read your site?",
            caption: "The Labs home page checks whether AI agents can read your site, right in your browser.",
          }}
        >
          <p>
            More recently, I've been exploring how we can <Badge icon="sparkles">help our customers understand AEO</Badge>. I came up with the idea of starting
            Sitebulb Labs, a small team where we can experiment with new ideas
            and build things without getting caught up in the usual product
            development process.
          </p>
        </Slide>

        <Slide
          id="extension"
          title="Which AEO features does a site support?"
          media={{
            image: "/case-studies/labs/3.jpg",
            alt: "Extension results with the top things to fix",
            caption: "Each result explains what was found, how to fix it, and why it matters.",
          }}
        >
          <p>
            Our first big project is a Chrome extension that checks which AEO
            features a website supports, alongside a documentation site that
            explains what those features actually do and whether they're worth
            implementing.
          </p>
          <p>
            I've been responsible for the <Badge icon="beaker">research, design and development</Badge>, which has meant
            getting pretty deep into how AI search actually works.
          </p>
        </Slide>

        <HorizontalGallery id="labs-work" items={labsWork} />

        <Slide
          id="research"
          title="Challenging what we tell people"
          media={{
            image: "/case-studies/labs/robots-txt.jpg",
            alt: "Sitebulb Labs robots.txt check: adoption on the top 100 sites and which agents support it",
            caption: "The robots.txt check shows how widely it's adopted, and which agents actually follow it.",
          }}
        >
          <p>
            <a href={RESEARCH_URL} target="_blank" rel="noopener">This page</a> came out of research showing that Gemini and Perplexity <Badge icon="robot">don't always follow robots.txt</Badge> rules when fetching pages on behalf of users.
          </p>
          <p>
            It's the sort of thing that challenges what we've been telling
            people about SEO for years.
          </p>
        </Slide>

        <Finale id="now" title="It's never changed this quickly" email="kevin@letchford.co">
          <p>
            I’ve worked in design and development around SEO for over ten
            years, and I can’t remember a time when the web has been changing
            this quickly. That’s what makes Searchable stand out to me.
          </p>
          <p>
            It covers so much of what I’ve become really interested in, and I’d
            like to <Badge icon="wormhole" class="whitespace-nowrap!">see where this wormhole goes</Badge>.
          </p>
        </Finale>
      </article>
    </div>
  </div>
</Layout>

<CaseStudiesScripts />

<script>
  import initSlideScroll from "../scripts/slide-scroll";

  let cleanup: (() => void) | undefined;

  // Registered after CaseStudiesScripts, so its scroller defaults exist.
  document.addEventListener("astro:page-load", () => {
    cleanup?.();
    const article = document.getElementById("slides");
    cleanup = article ? initSlideScroll(article) : undefined;
  });

  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
