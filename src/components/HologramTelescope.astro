---
// Hologram telescope that turns as its slide scrolls by (see scripts/hologram-telescope.ts).
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div
  data-hologram-telescope
  role="img"
  aria-label="A hologram of a telescope"
  class:list={["opacity-0 transition-opacity duration-1000", className]}
>
</div>

<script>
  import initHologramTelescope from "../scripts/hologram-telescope";

  const cleanups: Array<() => void> = [];

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-hologram-telescope]").forEach((el) => {
      if (el.hasAttribute("data-inited")) return;
      el.setAttribute("data-inited", "");
      cleanups.push(initHologramTelescope(el));
    });
  });

  document.addEventListener("astro:before-swap", () => {
    while (cleanups.length) cleanups.pop()?.();
  });
</script>
