<style>
  /* The whole phrase is the pill. It stays inline so long phrases can wrap,
     and each wrapped line gets its own rounded ends. */
  .badge-group {
    padding: 0.1em 0.6em 0.1em 0.3em;
    border-radius: 9999px;
    background: white;
    color: #0f172a;
    /* Gotham Book thickened with a hairline stroke, to sit between Book and
       Bold (no Medium weight is loaded) */
    font-weight: 450;
    -webkit-text-stroke: 0.04em currentColor;
    text-shadow: none;
    white-space: normal;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.25),
      0 0 18px rgb(255 255 255 / 0.15);
    transition: box-shadow 0.25s;
  }

  .badge-group:hover {
    box-shadow:
      0 2px 6px rgb(0 0 0 / 0.3),
      0 0 28px rgb(255 255 255 / 0.4);
  }

  .badge-lead {
    white-space: nowrap;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.2em;
    height: 1.2em;
    margin-right: 0.25em;
    vertical-align: -0.2em;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .badge svg {
    width: 85%;
    height: 85%;
    overflow: visible;
  }

  /* Only the animated parts (they all have a class): fill-box would also
     re-centre the static rotate() transforms on the wave hand and break it. */
  .badge svg [class] {
    transform-box: fill-box;
    /* Paused off screen; the script below sets .in-view */
    animation-play-state: paused;
  }

  .badge-group.in-view .badge svg [class] {
    animation-play-state: running;
  }

  .badge-group:hover .badge {
    transform: scale(1.12) rotate(-4deg);
  }

  /* Wave: a bigger, full-colour hand that rocks from the wrist while the
     motion lines flicker */
  .badge-group[data-icon="wave"] .badge svg {
    width: 115%;
    height: 115%;
  }
  .hand {
    transform-origin: 45% 100%;
  }
  .motion {
    animation: motion 0.6s ease-in-out infinite alternate;
  }
  @keyframes motion {
    from { opacity: 1; }
    to { opacity: 0.25; }
  }
  .hand {
    animation: wave 1.2s ease-in-out infinite;
  }
  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0); }
    10%, 30% { transform: rotate(16deg); }
    20%, 40% { transform: rotate(-10deg); }
    50% { transform: rotate(8deg); }
  }

  /* Search: a sci-fi scanner, a scan line sweeps the glass while the
     dashed ring orbits and the target pings */
  .badge-group[data-icon="search"] .badge svg {
    width: 110%;
    height: 110%;
    /* Sit lower so the orbit ring and the bob stay inside the pill */
    transform: translateY(0.12em);
  }
  .lens {
    transform-origin: center;
    animation: scan 3s ease-in-out infinite;
  }
  @keyframes scan {
    0%, 100% { transform: translate(0, 0); }
    25% { transform: translate(-1px, -0.5px); }
    50% { transform: translate(1px, -1px); }
    75% { transform: translate(1px, 0); }
  }
  .scanline {
    animation: scanline 1.6s linear infinite;
  }
  @keyframes scanline {
    from { transform: translateY(0); opacity: 0; }
    15%, 85% { opacity: 0.85; }
    to { transform: translateY(11px); opacity: 0; }
  }
  .orbit {
    transform-origin: center;
    animation: orbit 6s linear infinite;
  }
  @keyframes orbit {
    to { transform: rotate(360deg); }
  }
  .ping {
    transform-origin: center;
    animation: ping 1.2s ease-in-out infinite;
  }
  @keyframes ping {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(0.6); }
  }
  .strip {
    animation: strip 1.6s ease-in-out infinite alternate;
  }
  @keyframes strip {
    from { opacity: 1; }
    to { opacity: 0.4; }
  }

  /* Chart: a holo readout, bars rebuild from the axis, staggered, then the
     trend line traces over them while a sweep crosses the glass */
  .badge-group[data-icon="chart"] .badge svg {
    width: 105%;
    height: 105%;
  }
  .bar {
    transform-origin: bottom;
    animation: grow 2.4s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
  }
  .bar-2 { animation-delay: 0.1s; }
  .bar-3 { animation-delay: 0.2s; }
  @keyframes grow {
    0% { transform: scaleY(0); }
    25%, 100% { transform: scaleY(1); }
  }
  .trace {
    animation: trace 2.4s ease-out infinite;
  }
  @keyframes trace {
    0%, 20% { stroke-dashoffset: 1; opacity: 1; }
    55%, 85% { stroke-dashoffset: 0; opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  .sweep {
    animation: sweep 2.4s linear infinite;
  }
  @keyframes sweep {
    from { transform: translateX(0); opacity: 0; }
    15%, 85% { opacity: 0.15; }
    to { transform: translateX(16.6px); opacity: 0; }
  }

  /* Sparkles: an energy star that pulses and turns a quarter, while the
     cyan glints twinkle and a spark orbits the ring */
  .badge-group[data-icon="sparkles"] .badge svg {
    width: 110%;
    height: 110%;
    transform: translateY(0.06em);
  }
  .star {
    transform-origin: center;
    animation: spin-pulse 2.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  .badge svg .spark {
    /* Turn around the star's centre, not the dot's own (beats the fill-box rule) */
    transform-box: view-box;
    transform-origin: 11px 11.5px;
    animation: orbit 3s linear infinite;
  }
  .twinkle {
    animation: twinkle 0.8s ease-in-out infinite alternate;
  }
  .twinkle-2 { animation-delay: 0.4s; }
  .twinkle {
    transform-origin: center;
  }
  @keyframes spin-pulse {
    0%, 30% { transform: rotate(0) scale(1); }
    50% { transform: rotate(45deg) scale(0.82); }
    70%, 100% { transform: rotate(90deg) scale(1); }
  }
  @keyframes twinkle {
    from { opacity: 1; transform: scale(1); }
    to { opacity: 0.15; transform: scale(0.5); }
  }

  /* Beaker: a lab flask whose glowing liquid sloshes while bubbles rise
     and pop */
  .badge-group[data-icon="beaker"] .badge svg {
    width: 105%;
    height: 105%;
  }
  .liquid {
    animation: slosh 1.6s ease-in-out infinite alternate;
  }
  @keyframes slosh {
    from { transform: translateY(0); }
    to { transform: translateY(0.6px); }
  }
  .bubble-3 { animation-delay: 0.9s; }
  .bubble {
    animation: bubble 1.2s ease-in infinite;
  }
  .bubble-2 { animation-delay: 0.5s; }
  @keyframes bubble {
    0% { transform: translateY(0) scale(1); opacity: 1; }
    80% { opacity: 1; }
    100% { transform: translateY(-8px) scale(1.8); opacity: 0; }
  }

  /* Robot: a sci-fi bot that blinks, scans its visor and twitches its
     antenna while the beacon pings */
  .badge-group[data-icon="robot"] .badge svg {
    width: 110%;
    height: 110%;
  }
  .visor-scan {
    animation: visor-scan 1.6s linear infinite;
  }
  @keyframes visor-scan {
    from { transform: translateY(0); opacity: 0; }
    15%, 85% { opacity: 0.7; }
    to { transform: translateY(5.8px); opacity: 0; }
  }
  .beacon {
    transform-origin: center;
    animation: ping 1.2s ease-in-out infinite;
  }
  .eyes {
    transform-origin: center;
  }
  .antenna {
    transform-origin: bottom;
  }
  .eyes {
    animation: blink 1.6s ease-in-out infinite;
  }
  .antenna {
    animation: twitch 0.8s ease-in-out infinite;
  }
  @keyframes blink {
    0%, 40%, 50%, 100% { transform: scaleY(1); }
    45% { transform: scaleY(0.1); }
  }
  @keyframes twitch {
    0%, 100% { transform: rotate(0); }
    25% { transform: rotate(-18deg); }
    75% { transform: rotate(18deg); }
  }

  /* Rocket: a Thunderbird 3 style rocket that rumbles with flickering
     plasma flames,
     launches out the top and re-enters from below */
  .badge-group[data-icon="rocket"] .badge {
    overflow: hidden;
  }
  .badge-group[data-icon="rocket"] .badge svg {
    width: 110%;
    height: 110%;
  }
  .flame {
    transform-origin: 50% 0;
  }
  .rocket {
    animation: launch 2s ease-in infinite;
  }
  .flame {
    animation: flicker 0.15s ease-in-out infinite alternate;
  }
  @keyframes launch {
    0%, 30% { transform: translate(0, 0); }
    5%, 15%, 25% { transform: translate(-0.5px, 0.5px); }
    10%, 20% { transform: translate(0.5px, -0.5px); }
    55% { transform: translate(24px, -24px); }
    56% { transform: translate(-24px, 24px); opacity: 0; }
    57% { opacity: 1; }
    80%, 100% { transform: translate(0, 0); }
  }
  @keyframes flicker {
    from { transform: scale(1, 0.85); }
    to { transform: scale(1.1, 1.3); }
  }

  /* Wormhole: spiral arms turn into the core while rings of light fall
     down the tunnel */
  .badge-group[data-icon="wormhole"] .badge svg {
    width: 100%;
    height: 100%;
    /* A full disc reads high next to lowercase text */
    translate: 0 0.06em;
  }
  /* Both spin and shrink about the middle of their own (centred) boxes */
  .swirl,
  .warp-ring {
    transform-origin: center;
  }
  .swirl {
    animation: swirl 4s linear infinite;
  }
  .warp-ring {
    opacity: 0;
    animation: warp-ring 1.8s ease-in infinite;
  }
  .warp-ring-2 { animation-delay: -0.6s; }
  .warp-ring-3 { animation-delay: -1.2s; }
  .core {
    transform-origin: center;
    animation: core-pulse 1.8s ease-in-out infinite;
  }
  @keyframes core-pulse {
    50% { transform: scale(1.35); }
  }
  @keyframes swirl {
    to { transform: rotate(-360deg); }
  }
  @keyframes warp-ring {
    0% { transform: scale(1); opacity: 0; }
    25% { opacity: 0.5; }
    100% { transform: scale(0.12); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge,
    .badge * {
      animation: none !important;
      transform: none;
    }
  }
</style>


<script>
  let observer: IntersectionObserver | undefined;

  document.addEventListener("astro:page-load", () => {
    observer?.disconnect();
    observer = new IntersectionObserver((entries) =>
      entries.forEach((e) => e.target.classList.toggle("in-view", e.isIntersecting)),
    );
    document.querySelectorAll(".badge-group").forEach((badge) => observer!.observe(badge));
  });

  document.addEventListener("astro:before-swap", () => {
    observer?.disconnect();
    observer = undefined;
  });
</script>
