---
// Opening section of a case study: project name as the eyebrow, a headline
// and subline, then the actions pill, all centred. The eyebrow is optional
// (`name`, or an `eyebrow` slot for richer markup), and a newline in the headline forces a line break.
interface Props {
  name?: string;
  headline: string;
  subline: string;
  /** `false` hides the read link; the pill goes too if there's no live link. */
  readHref?: string | false;
  readLabel?: string;
  liveHref?: string;
  /** A quieter second in-page link beside the read link, which then takes the
      solid primary style. */
  skipHref?: string;
  skipLabel?: string;
  class?: string;
}

const {
  name,
  headline,
  subline,
  readHref = "#gallery",
  readLabel = "Read case study",
  liveHref,
  skipHref,
  skipLabel = "Skip ahead",
  class: className,
} = Astro.props;
---

<section
  class:list={[
    "px-6 md:px-24 py-28 min-h-[100svh] flex flex-col justify-center max-w-6xl m-auto w-full",
    className,
  ]}
  aria-labelledby="title-heading"
  id="title"
>
  <div
    class="relative isolate flex flex-col items-center text-center gap-10"
  >
    <!-- Soft dark scrim that feathers out, so the text reads over the space backdrop -->
    <div
      aria-hidden="true"
      class="absolute -inset-x-64 -inset-y-56 -z-10 pointer-events-none bg-[radial-gradient(closest-side,rgb(0_0_0/0.5),rgb(0_0_0/0.42)_25%,rgb(0_0_0/0.26)_50%,rgb(0_0_0/0.1)_75%,transparent)]"
    >
    </div>
    <div>
      {(name || Astro.slots.has("eyebrow")) && (
        <p class="mb-2 text-white text-xl md:text-2xl font-bold font-space [text-shadow:0_1px_2px_rgb(0_0_0/0.4)]">
          <slot name="eyebrow">{name}</slot>
        </p>
      )}
      <h1
        id="title-heading"
        class="text-5xl md:text-6xl/[1.05] lg:text-7xl/[1.05] font-bold font-space tracking-tight text-balance max-w-[16ch] mx-auto text-red-400 [text-shadow:0_2px_4px_rgb(0_0_0/0.3),0_2px_24px_rgb(0_0_0/0.35)]"
      >
        {headline.split("\n").map((line, i) => <>{i > 0 && <br />}{line}</>)}
      </h1>
      <p
        class="mt-5 mx-auto max-w-[40ch] [text-shadow:0_1px_2px_rgb(0_0_0/0.4),0_1px_12px_rgb(0_0_0/0.5)] text-white/90 text-lg md:text-2xl/9 text-balance"
      >
        {subline}
      </p>
    </div>

    {(readHref || liveHref) && (
    <div
      class="inline-flex items-center gap-1 p-1.5 rounded-full bg-white/10 border border-white/10 backdrop-blur-xl"
    >
      {
        readHref && (
          <a
            href={readHref}
            data-scroll-to={readHref.slice(1)}
            class:list={[
              "py-2 rounded-full transition-colors",
              skipHref
                ? "group inline-flex items-center gap-1.5 px-3 sm:px-4 whitespace-nowrap text-sm sm:text-base bg-white text-slate-900 font-bold hover:bg-red-50"
                : "px-4 text-white/90 hover:text-white hover:bg-white/10",
            ]}
          >
            {readLabel}
            {skipHref && (
              <svg
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="hero-arrow size-3.5 sm:size-4 text-red-500"
              >
                <path d="M8 2.5v10M3.5 8.5 8 13l4.5-4.5" />
              </svg>
            )}
          </a>
        )
      }
      {
        skipHref && (
          <a
            href={skipHref}
            data-scroll-to={skipHref.slice(1)}
            class="px-3 sm:px-4 py-2 rounded-full whitespace-nowrap text-sm sm:text-base text-white/80 hover:text-white hover:bg-white/10 transition-colors"
          >
            {skipLabel}
          </a>
        )
      }
      {
        liveHref && (
          <a
            href={liveHref}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white text-slate-900 font-bold hover:bg-red-50 transition-colors"
          >
            Live site
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              aria-hidden="true"
              class="size-4"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M3 12h18M12 3c2.5 2.6 3.75 5.6 3.75 9S14.5 18.4 12 21c-2.5-2.6-3.75-5.6-3.75-9S9.5 5.6 12 3z" />
            </svg>
          </a>
        )
      }
    </div>
    )}
  </div>
</section>

<style>
  /* The primary in-page link's arrow nudges downwards, inviting a scroll */
  .hero-arrow {
    animation: hero-arrow 1.6s ease-in-out infinite;
  }
  .group:hover .hero-arrow {
    animation-duration: 0.8s;
  }
  @keyframes hero-arrow {
    0%, 100% { transform: translateY(-1px); }
    50% { transform: translateY(2px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-arrow {
      animation: none;
    }
  }
</style>
